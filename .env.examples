API_PORT=

CUDA_VERSION=12.1.1
PYTORCH_VERSION=2.5.1
TORCHVISION_VERSION=0.20.1
XFORMERS_VERSION=0.0.28.post3
PYTORCH_CUDA_INDEX=cu121

SOULX_MODEL_TYPE=lite
SOULX_MODELS_DIR=./app/thirdparty/SoulX_FlashHead/models

AUDIO_STORAGE=/dev/shm/audio

SEED=42
USE_FACE_CROP=false
AUDIO_ENCODE_MODE=stream
WORLD_SIZE=1

PUBLIC_BASE_URL=http://<YOUR_PUBLIC_IP>:${API_PORT}
DOWNLOAD_URL_TTL_SECONDS=300
DOWNLOAD_URL_SECRET=<YOUR_URL_SECRET>

